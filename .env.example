# Exemplo sem credenciais reais para executar a API fora do Docker.
# O Spring não lê este arquivo automaticamente; configure as variáveis na IDE.
# Para o Compose, use .env.dev.example ou .env.prod.example como base.

DB_NAME=clai_db
DB_USER=clai_user
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://localhost:5432/clai_db
FRONTEND_URL=http://localhost:5173