# Copie este arquivo para .env antes de subir o ambiente.
# Nao use aspas nos valores.

DB_NAME=clai_db
DB_USER=clai_user
DB_PASSWORD=change_me

# Usada so ao rodar a API fora do Docker (pela IDE).
# Dentro do Docker o compose sobrescreve com o host "postgres".
DB_URL=jdbc:postgresql://localhost:5432/clai_db